diff --git a/src/taskforge/job_authority.py b/src/taskforge/job_authority.py
new file mode 100644
index 0000000..73191ef
--- /dev/null
+++ b/src/taskforge/job_authority.py
@@ -0,0 +1,61 @@
+from __future__ import annotations
+
+from taskforge import state
+from taskforge.model import Job, JobStatus
+
+
+class JobAuthority:
+    """Single semantic owner for TaskForge job lifecycle state."""
+
+    def submit(self, command: str) -> str:
+        job_id = f"job-{state.next_job_number}"
+        state.next_job_number += 1
+        state.jobs[job_id] = Job(id=job_id, command=command)
+        return job_id
+
+    def get(self, job_id: str) -> Job:
+        return state.jobs[job_id]
+
+    def list_jobs(self) -> list[Job]:
+        # Stable ordering makes downstream output deterministic.
+        return [state.jobs[job_id] for job_id in sorted(state.jobs)]
+
+    def cancel(self, job_id: str) -> bool:
+        # Missing jobs are not cancellable, just like running/terminal jobs.
+        try:
+            job = state.jobs[job_id]
+        except KeyError:
+            return False
+        if job.terminal or job.status == JobStatus.RUNNING:
+            return False
+        job.status = JobStatus.CANCELLED
+        return True
+
+    def claim_next(self) -> Job | None:
+        # Use the same stable ordering as list_jobs so all readers agree.
+        for job_id in sorted(state.jobs):
+            job = state.jobs[job_id]
+            if job.status == JobStatus.QUEUED:
+                job.status = JobStatus.RUNNING
+                return job
+        return None
+
+    def finish(self, job_id: str, exit_code: int) -> None:
+        job = state.jobs[job_id]
+        if job.status != JobStatus.RUNNING:
+            raise ValueError(f"cannot finish {job_id} from {job.status.value}")
+        job.exit_code = exit_code
+        job.status = JobStatus.SUCCEEDED if exit_code == 0 else JobStatus.FAILED
+
+    def queued_count(self) -> int:
+        return sum(job.status == JobStatus.QUEUED for job in state.jobs.values())
+
+    def terminal_count(self) -> int:
+        return sum(job.terminal for job in state.jobs.values())
+
+    def reset_for_tests(self) -> None:
+        state.jobs.clear()
+        state.next_job_number = 1
+
+
+default_authority = JobAuthority()
