diff --git a/tests/test_job_authority.py b/tests/test_job_authority.py
new file mode 100644
index 0000000..96cd40b
--- /dev/null
+++ b/tests/test_job_authority.py
@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+from taskforge import metrics, service, worker
+
+
+def test_authority_keeps_service_and_worker_on_same_state() -> None:
+    service.reset_for_tests()
+    first = service.submit("echo first")
+    second = service.submit("echo second")
+    assert [job.id for job in service.list_jobs()] == [first, second]
+    assert worker.claim_next().id == first
+    assert metrics.queued_count() == 1
+
+
+def test_cancel_missing_job_is_false() -> None:
+    service.reset_for_tests()
+    assert service.cancel("job-missing") is False
+
+
+def test_finish_still_records_exit_code() -> None:
+    service.reset_for_tests()
+    job_id = service.submit("false")
+    worker.claim_next()
+    worker.finish(job_id, 7)
+    assert service.get(job_id).exit_code == 7
